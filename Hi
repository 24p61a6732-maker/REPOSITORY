apiVersion: apps/v1
kind: Deployment
metadata:
  name: mykubeapp
spec:
  replicas: 2
  selector:
    matchLabels:
      app: mykubeapp
  template:
    metadata:
      labels:
        app: mykubeapp
    spec:
      containers:
      - name: mykubeapp
        image: localhost:32000/mykubeapp
        ports:
        - containerPort: 5000

